# ─────────────────────────────────────────────────────────────────────────────
# Environment template — copy to `.env` and fill in real values.
# Every business-specific value below is a PLACEHOLDER (see docs/ASSUMPTIONS.md).
# The app reads these ONLY through lib/config (SPEC §34, §57).
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
# changing them requires a rebuild (`npm run build`).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Local native Postgres or `docker compose up -d` (see docker-compose.yml).
DATABASE_URL="postgresql://realestate:realestate@localhost:5432/realestate?schema=public"

# ── Site (required) ──────────────────────────────────────────────────────────
# Absolute URL, no trailing slash. Used for canonical URLs, sitemaps and WhatsApp links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Only "true" in production. Anything else = noindex + robots disallow everywhere.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# ── Business identity (required) — PLACEHOLDERS, replace before launch ───────
NEXT_PUBLIC_BUSINESS_NAME="Demo Realty Jaipur"
NEXT_PUBLIC_BUSINESS_PHONE="+91 90000 00000"
NEXT_PUBLIC_BUSINESS_EMAIL="hello@example.com"
NEXT_PUBLIC_BUSINESS_ADDRESS_LINE1="Office No. 0, Demo Business Centre"
NEXT_PUBLIC_BUSINESS_CITY="Jaipur"
NEXT_PUBLIC_BUSINESS_STATE="Rajasthan"
NEXT_PUBLIC_BUSINESS_PINCODE="302021"

# ── Business identity (optional) ─────────────────────────────────────────────
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=""
NEXT_PUBLIC_BUSINESS_TAGLINE="Homes, plots & commercial spaces across Jaipur"
# Mobile number used for WhatsApp. Defaults to NEXT_PUBLIC_BUSINESS_PHONE when empty.
NEXT_PUBLIC_BUSINESS_WHATSAPP=""
NEXT_PUBLIC_BUSINESS_PHONE_SECONDARY=""
NEXT_PUBLIC_BUSINESS_ADDRESS_LINE2="Vaishali Nagar"
# Office coordinates (map on /contact, LocalBusiness schema). PLACEHOLDER = Vaishali Nagar centroid.
NEXT_PUBLIC_BUSINESS_LAT="26.9110"
NEXT_PUBLIC_BUSINESS_LNG="75.7430"
NEXT_PUBLIC_BUSINESS_HOURS="Mon–Sat 10:00–19:00"
# Path under /public or absolute https URL. Empty = text wordmark.
NEXT_PUBLIC_BUSINESS_LOGO_URL=""
# Rajasthan RERA agent registration number. Leave empty until you have a real one — never invent it.
NEXT_PUBLIC_RERA_AGENT_NUMBER=""

# ── Social profiles (optional; hidden when empty) ────────────────────────────
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_X=""

# ── Analytics (optional; scripts load only when an ID is set) ────────────────
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_CLARITY_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# "true" = analytics waits for cookie-banner opt-in (SPEC §50).
NEXT_PUBLIC_REQUIRE_ANALYTICS_CONSENT="false"

# ── Maps (optional) ──────────────────────────────────────────────────────────
# "osm" (OpenStreetMap, no key) or "google" (needs the key below).
NEXT_PUBLIC_MAP_PROVIDER="osm"
# Google Maps Embed API browser key — restrict it to your domain in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ── Security (server only; required in production) ───────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
IP_HASH_SALT=""

# ── Email notifications (optional; leads are logged to the console when unset) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Comma-separated recipients for new-lead emails.
LEAD_NOTIFICATION_EMAIL=""

# ── Spam protection (optional) ───────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Uploads ──────────────────────────────────────────────────────────────────
# "local" stores files in ./storage/uploads (needs a persistent disk in production).
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO).
STORAGE_DRIVER="local"
# Optional: where "local" uploads live. Default storage/uploads (relative to the working
# directory). Use an absolute path with the standalone/Docker server, e.g. /app/storage/uploads
STORAGE_LOCAL_DIR=""
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for uploaded objects, e.g. https://cdn.example.com
S3_PUBLIC_URL=""

# ── Deployment ───────────────────────────────────────────────────────────────
# How many reverse proxies sit in front of the app, used to read the real client IP
# (rate limits, view counts). Caddy or Nginx = 1; Cloudflare → Caddy = 2.
TRUSTED_PROXY_COUNT="1"

# Only for docker-compose.prod.yml (see docs/DEPLOYMENT.md). With that stack, DATABASE_URL is
# postgresql://realestate:<POSTGRES_PASSWORD>@db:5432/realestate?schema=public
POSTGRES_PASSWORD=""
# Bare domain served by Caddy with automatic HTTPS, e.g. example.com
DOMAIN=""
